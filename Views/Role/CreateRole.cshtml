@model Microsoft.AspNetCore.Identity.IdentityRole

@{
    ViewData["Title"] = "Create Role";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
    <div class="card shadow-sm p-4" style="max-width: 400px; width: 100%; border: 1px solid #ff4d4d;">
        <!-- Yazaki Logo -->
        <div class="text-center mb-4">
            <img src="/images/yazaki-logo.png" alt="Yazaki Logo" style="max-width: 150px;" />
        </div>

        <!-- Title -->
        <h2 class="text-center mb-4">IT Asset Management</h2>

        <!-- Subtitle -->
        <p class="text-center text-muted mb-4">Create a new role</p>

        <!-- Form -->
        <form asp-action="CreateRole" method="post">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <div class="form-group mb-3">
                <label asp-for="Name" class="form-label">Role Name</label>
                <input asp-for="Name" class="form-control" placeholder="Enter role name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group d-flex justify-content-between">
                <button type="submit" class="btn" style="background-color: #ff4d4d; color: white;">Create</button>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}