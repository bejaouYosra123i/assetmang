<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IT Asset Management</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <!-- Add Poppins font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #f5f5f5, #ffffff); /* Match Index.cshtml background */
            margin: 0;
        }

        /* Style du menu latéral */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            height: 100%;
            width: 50px; /* Default collapsed size */
            background-color: #1a1a1a;
            padding-top: 20px;
            color: white;
            transition: all 0.3s;
        }

            .sidebar.expanded {
                width: 250px; /* Expanded size */
            }

            .sidebar .logo {
                text-align: center;
                margin-bottom: 30px;
            }

                .sidebar .logo img {
                    max-width: 40px; /* Smaller logo by default */
                    transition: all 0.3s;
                }

            .sidebar.expanded .logo img {
                max-width: 150px; /* Larger logo when expanded */
            }

            .sidebar h4 {
                color: #ff4d4d;
                text-align: center;
                margin-bottom: 30px;
                display: none; /* Hidden by default */
                transition: all 0.3s;
            }

            .sidebar.expanded h4 {
                display: block; /* Show title when expanded */
            }

            .sidebar a {
                padding: 15px 10px; /* Adjusted padding for smaller collapsed state */
                display: block;
                color: white;
                text-decoration: none;
                transition: all 0.3s;
                white-space: nowrap;
            }

            .sidebar.expanded a {
                padding: 15px 20px; /* Normal padding when expanded */
            }

            .sidebar a:hover {
                background-color: #ff4d4d;
                color: white;
            }

            .sidebar a i {
                margin-right: 10px;
                width: 20px; /* Fixed width for icons */
            }

            .sidebar a span {
                display: none; /* Hidden by default */
            }

            .sidebar.expanded a span {
                display: inline; /* Show text when expanded */
            }

        /* Toggle button */
        .toggle-btn {
            position: absolute;
            top: 10px;
            right: -40px;
            background-color: #ff4d4d;
            color: white;
            border: none;
            padding: 5px 10px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .sidebar.expanded .toggle-btn {
            right: -40px; /* Adjust position when expanded */
        }

        /* Contenu principal */
        .content {
            margin-left: 50px; /* Default margin for collapsed sidebar */
            padding: 20px;
            transition: all 0.3s;
        }

            .content.expanded {
                margin-left: 250px; /* Margin when sidebar is expanded */
            }

        .swal2-confirm {
            background-color: #ff4d4d !important;
        }

        .logout-link {
            position: absolute;
            bottom: 20px;
            width: 100%;
        }
    </style>
</head>
<body>
    @if (User.Identity.IsAuthenticated)
    {
        <!-- Menu latéral pour les utilisateurs connectés -->
        <div class="sidebar" id="sidebar">
            <button class="toggle-btn" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
            <div class="logo">
                <img src="/images/yazaki-logo.png" alt="Yazaki Logo" />
            </div>
            <h4>IT Asset Management</h4>
            <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> <span>Dashboard</span></a>
            <a asp-controller="Home" asp-action="Privacy"><i class="fas fa-lock"></i> <span>Privacy</span></a>
            <!-- Link to create a new investment request -->
            <a asp-controller="InvestmentRequests" asp-action="Create"><i class="fas fa-plus"></i> <span>Create</span></a>
            <!-- Link to view the list of investment requests -->
            <a asp-controller="InvestmentRequests" asp-action="Index"><i class="fas fa-list"></i> <span>Investment Requests</span></a>

            @if (User.IsInRole("admin"))
            {
                <a asp-controller="Role" asp-action="Index"><i class="fas fa-users-cog"></i> <span>Role Management</span></a>
                <a asp-area="Identity" asp-page="/Account/Register"><i class="fas fa-user-plus"></i> <span>Create User</span></a>
            }
            <!-- Add Settings link -->
            <a asp-controller="Profile" asp-action="Index"><i class="fas fa-cog"></i> <span>Settings</span></a>
            <div class="logout-link">
                <a asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <i class="fas fa-sign-out-alt"></i> <span>Logout</span>
                </a>
            </div>
        </div>

        <!-- Contenu principal -->
        <div class="content" id="content">
            <main role="main">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <main role="main">
            @RenderBody()
        </main>
    }

    <!-- Scripts nécessaires -->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Toggle the sidebar visibility
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const content = document.getElementById('content');
            sidebar.classList.toggle('expanded');
            content.classList.toggle('expanded');
            // Save the sidebar state to localStorage
            localStorage.setItem('sidebarExpanded', sidebar.classList.contains('expanded'));
        }

        // Restore sidebar state on page load
        document.addEventListener('DOMContentLoaded', function () {
            const sidebar = document.getElementById('sidebar');
            const content = document.getElementById('content');
            const isExpanded = localStorage.getItem('sidebarExpanded') === 'true';
            if (isExpanded) {
                sidebar.classList.add('expanded');
                content.classList.add('expanded');
            }

            const successMessage = '@TempData["SuccessMessage"]';
            if (successMessage) {
                Swal.fire({
                    icon: 'success',
                    title: 'Success',
                    text: successMessage,
                    confirmButtonText: 'OK',
                    confirmButtonColor: '#ff4d4d' // Yazaki red for the OK button
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>