<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IT Asset Management</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <!-- Add Poppins font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #f5f5f5, #ffffff);
            margin: 0;
        }

        /* Style du menu latéral */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            height: 100%;
            width: 50px;
            background-color: #1a1a1a;
            padding-top: 20px;
            color: white;
            transition: all 0.3s;
        }

            .sidebar.expanded {
                width: 250px;
            }

            .sidebar .logo {
                text-align: center;
                margin-bottom: 30px;
            }

                .sidebar .logo img {
                    max-width: 40px;
                    transition: all 0.3s;
                }

            .sidebar.expanded .logo img {
                max-width: 150px;
            }

            .sidebar h4 {
                color: #ff4d4d;
                text-align: center;
                margin-bottom: 30px;
                display: none;
                transition: all 0.3s;
            }

            .sidebar.expanded h4 {
                display: block;
            }

            .sidebar a {
                padding: 15px 10px;
                display: block;
                color: white;
                text-decoration: none;
                transition: all 0.3s;
                white-space: nowrap;
            }

            .sidebar.expanded a {
                padding: 15px 20px;
            }

            .sidebar a:hover {
                background-color: #ff4d4d;
                color: white;
            }

            .sidebar a i {
                margin-right: 10px;
                width: 20px;
            }

            .sidebar a span {
                display: none;
            }

            .sidebar.expanded a span {
                display: inline;
            }

        /* Toggle button */
        .toggle-btn {
            position: absolute;
            top: 10px;
            right: -40px;
            background-color: #ff4d4d;
            color: white;
            border: none;
            padding: 5px 10px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .sidebar.expanded .toggle-btn {
            right: -40px;
        }

        /* Contenu principal */
        .content {
            margin-left: 50px;
            padding: 20px;
            transition: all 0.3s;
        }

            .content.expanded {
                margin-left: 250px;
            }

        .swal2-confirm {
            background-color: #ff4d4d !important;
        }

        .logout-link {
            position: absolute;
            bottom: 20px;
            width: 100%;
        }

        /* Nested menu for sub-items */
        .sidebar .sub-menu {
            display: none;
            padding-left: 20px;
        }

            .sidebar .sub-menu a {
                padding: 10px 20px;
                font-size: 0.9em;
            }
    </style>
</head>
<body>
    @if (User.Identity.IsAuthenticated)
    {
        <!-- Menu latéral pour les utilisateurs connectés -->
        <div class="sidebar" id="sidebar">
            <button class="toggle-btn" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
            <div class="logo">
                <img src="/images/yazaki-logo.png" alt="Yazaki Logo" />
            </div>
            <h4>IT Asset Management</h4>
            <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> <span>Dashboard</span></a>
            <a asp-controller="Home" asp-action="Privacy"><i class="fas fa-lock"></i> <span>Privacy</span></a>
            <a asp-controller="InvestmentRequests" asp-action="Create"><i class="fas fa-plus"></i> <span>Create</span></a>
            <a asp-controller="InvestmentRequests" asp-action="Index"><i class="fas fa-list"></i> <span>Investment Requests</span></a>

            <!-- User Management Section -->
            <a href="javascript:void(0)" onclick="toggleSubMenu(this)"><i class="fas fa-users"></i> <span>Users Management</span></a>
            <div class="sub-menu">
                <a asp-controller="Profiles" asp-action="Index"><i class="fas fa-address-book"></i> <span>Profiles List</span></a>
                <a asp-controller="Role" asp-action="Index"><i class="fas fa-users-cog"></i> <span>Manage Roles</span></a>
                <a asp-area="Identity" asp-page="/Account/Register"><i class="fas fa-user-plus"></i> <span>Create User</span></a>
            </div>

            <!-- PC Requests Management Section -->
            <a href="javascript:void(0)" onclick="toggleSubMenu(this)"><i class="fas fa-desktop"></i> <span>PC Requests Management</span></a>
            <div class="sub-menu">
                <a asp-controller="PcRequests" asp-action="Index"><i class="fas fa-list-ul"></i> <span>PC Requests List</span></a>
                <a asp-controller="PcRequests" asp-action="Create"><i class="fas fa-plus-circle"></i> <span>Create PC Request</span></a>
            </div>

            <a asp-controller="Profile" asp-action="Index"><i class="fas fa-cog"></i> <span>Settings</span></a>
            <div class="logout-link">
                <a asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <i class="fas fa-sign-out-alt"></i> <span>Logout</span>
                </a>
            </div>
        </div>

        <!-- Contenu principal -->
        <div class="content" id="content">
            <main role="main">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <main role="main">
            @RenderBody()
        </main>
    }

    <!-- Scripts nécessaires -->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Toggle the sidebar visibility
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const content = document.getElementById('content');
            sidebar.classList.toggle('expanded');
            content.classList.toggle('expanded');
            localStorage.setItem('sidebarExpanded', sidebar.classList.contains('expanded'));
        }

        // Toggle sub-menu visibility
        function toggleSubMenu(element) {
            const subMenu = element.nextElementSibling;
            subMenu.style.display = (subMenu.style.display === "block") ? "none" : "block";
        }

        // Restore sidebar state on page load
        document.addEventListener('DOMContentLoaded', function () {
            const sidebar = document.getElementById('sidebar');
            const content = document.getElementById('content');
            const isExpanded = localStorage.getItem('sidebarExpanded') === 'true';
            if (isExpanded) {
                sidebar.classList.add('expanded');
                content.classList.add('expanded');
            }

            const successMessage = '@TempData["SuccessMessage"]';
            if (successMessage) {
                Swal.fire({
                    icon: 'success',
                    title: 'Success',
                    text: successMessage,
                    confirmButtonText: 'OK',
                    confirmButtonColor: '#ff4d4d',
                    backdrop: 'rgba(0,0,0,0.7)',
                    showClass: {
                        popup: 'animate__animated animate__fadeInDown'
                    },
                    hideClass: {
                        popup: 'animate__animated animate__fadeOutUp'
                    },
                    customClass: {
                        popup: 'modern-swal-popup',
                        title: 'modern-swal-title',
                        content: 'modern-swal-content',
                        confirmButton: 'modern-swal-button'
                    }
                });
            }
        });
    </script>
    <style>
        .modern-swal-popup {
            border-radius: 15px !important;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2) !important;
            border: 1px solid #ff4d4d !important;
            padding: 20px !important;
        }

        .modern-swal-title {
            font-size: 1.5rem !important;
            color: #ff4d4d !important;
            font-weight: 600 !important;
        }

        .modern-swal-content {
            font-size: 1rem !important;
            color: #333 !important;
        }

        .modern-swal-button {
            border-radius: 20px !important;
            padding: 10px 30px !important;
            font-size: 1rem !important;
            transition: all 0.3s ease !important;
        }

            .modern-swal-button:hover {
                background-color: #e64444 !important;
                transform: scale(1.05) !important;
            }
    </style>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4=" crossorigin="anonymous"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>